# .sh files need to have UNIX line endings
# Even on Windows, otherwise this will break Docker builds
*.sh eol=lf

# Render fixtures are byte-exact and may intentionally end lines with visible output spaces.
test/**/output.txt whitespace=-trailing-space
test/**/wikidot.html whitespace=-blank-at-eof

# These heading markers intentionally end with a syntax-significant space.
tests/fixtures/parity-gaps/heading-adjacent-empty-first/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/heading-adjacent-notoc-empty-last/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/heading-empty-next-line-footnote/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/heading-empty-notoc/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/heading-empty-toc/input.ftml whitespace=-trailing-space

# This parity input intentionally contains one CRLF sequence.
tests/fixtures/parity-gaps/math-crlf/input.ftml -text

# This comment/preprocessor witness intentionally contains a CR byte before a comment and LF.
tests/fixtures/parity-gaps/comment-crlf-join/input.ftml -text

# This include witness intentionally contains syntax-significant trailing ASCII whitespace.
test/include/wikidot-argument-whitespace/input.ftml whitespace=-trailing-space

# These content-separator witnesses intentionally contain syntax-significant trailing ASCII whitespace.
tests/fixtures/parity-gaps/content-separator-ascii-padding/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/content-separator-crlf-overlong/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/content-separator-trailing-space/input.ftml whitespace=-trailing-space
tests/fixtures/parity-gaps/content-separator-trailing-tab/input.ftml whitespace=-trailing-space

# These whitespace witnesses intentionally contain CRLF or bare CR bytes.
tests/fixtures/parity-gaps/whitespace-crlf-code-body/input.ftml -text
tests/fixtures/parity-gaps/whitespace-mac-newline/input.ftml -text

# This whitespace witness intentionally contains a NUL byte.
tests/fixtures/parity-gaps/whitespace-nul-prose/input.ftml -text
