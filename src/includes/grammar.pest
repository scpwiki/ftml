// A simple parser generation exclusively to extract [[include]] directives
// within the wikitext. Other elements should be ignored and left as-is.

// Wikidot requires spacing between the target and an argument tail. Once the
// tail starts, each pipe ends the current segment even when the pipe appears
// between quotes. Segment recovery and argument validation are intentionally
// handled by the include parser so one inert segment cannot reject the block.

// Top-level rule
// Live rejects any whitespace between "[[" and "include", so the opener is tight.
include = {
    SOI ~ // Because we slice from the start of an include block using regex
    "[[" ~ ^"include" ~ whitespace ~
    page_ref ~
    (whitespace ~ stray_open_brackets? ~ argument_tail)? ~
    include_end
}

include_end = _{
    "]]" ~ &(NEWLINE | EOI)
}

argument_tail = {
    (!include_end ~ ANY)*
}

// Wikidot tolerates a run of stray open brackets between the page reference and
// the arguments, discarding it and parsing the arguments normally. Four pages in
// the imported corpus rely on this, all writing a bare "[[" on the line after
// the page reference; live renders their arguments and shows no bracket. Only
// open brackets are accepted, and only in this position, because that is the
// shape the evidence covers.
stray_open_brackets = _{
    !"[!--" ~ "["+ ~ space?
}

// Reference to a page, possibly not on this wiki

page_ref = {
    (":" ~ site_name ~ ":")? ~ page_name
}
site_name = _{ (!(" " | "\n" | "\t" | "[" | "|" | "]" | ":" | "\"" | "'") ~ ANY)+ }
page_name = _{ (!(" " | "\n" | "\t" | "[" | "|" | "]" | "\"" | "'") ~ ANY)+ }

// Helpers

comment = _{ "[!--" ~ (!("--]") ~ ANY)* ~ "--]" }
space = _{ (" " | "\n" | "\t" | comment)+ }
whitespace = _{ (" " | "\n" | "\t")+ }

// vim: set fdm=marker foldlevel=0:
